# Entorno virtual local
.venv/
env/
venv/

# Ficheros de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Datos grandes (NO subir Cornell)
data/
# Si quieres dejar data/ con un README:
# !data/README.md

# Experimentos viejos / copias locales
experiments/_old/

# Backups editor/script
*.bak_*

# Experimentos: ignora cosas pesadas (pesos y checkpoints)
experiments/*/checkpoints/
experiments/**/*.pth
experiments/**/*.pt
experiments/**/*.ckpt
experiments/**/*.log

# --- Permitir plots de resultados (para memoria del trabajo) ---
!experiments/plots/
!experiments/plots/*.png

# Resúmenes (estos SÍ conviene subir, son ligeros)
!experiments/summary_base.csv
!experiments/summary_base_pretty.md

# Reports: por defecto NO subir dumps pesados
reports/**/*.csv
reports/**/*.json

# Permitimos las tablas/listados destinados a la memoria final
!reports/tablas_memoria/
!reports/tablas_memoria/*.csv
!reports/tablas_memoria/*.md
!reports/tablas_memoria/figures_memoria/

# Pero SÍ subir los index_files PRO (reproducibilidad)
!reports/cornell_audit/clean_idx_train.txt
!reports/cornell_audit/clean_idx_train_v2.txt
!reports/cornell_audit/clean_idx_val.txt
!reports/cornell_audit/scan_bad_train.txt
!reports/cornell_audit/scan_bad_train_aug.txt

# Temporales
tmp/
_dump_txt_files.txt

# Cosas típicas
.DS_Store
*.swp
*.swo
BORRAR/
.venv*/
.venv_ai/
.matplotlib_cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.png
